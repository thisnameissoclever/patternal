                                x:Name="HeightSlider"
                                AutomationProperties.Name="Height in centimeters"
                                Maximum="205"
                                Minimum="140"
                                SmallChange="0.5"
                                StepFrequency="0.5"
                                Value="167"
                                ValueChanged="OnMeasurementChanged" />
                        </StackPanel>

