                            IsOn="False"
                            Toggled="OnAvatarDisplayOptionToggled" />

                        <TextBlock
                            x:Name="BraAvailabilityText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Loading the fitted presentation asset. The supported bust shape and cloth collision body stay identical."
                            TextWrapping="Wrap" />

                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Key dimensions drive the pattern immediately. Open any region below to correct surface, landmark, depth, projection, or left and right asymmetry values."
