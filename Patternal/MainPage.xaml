                            <Grid>
                                <TextBlock Text="Full bust circumference" />
                                <TextBlock x:Name="ChestValueText" Style="{StaticResource MeasurementValueStyle}" Text="112 cm" />
                            </Grid>
                            <Slider
                                x:Name="ChestSlider"
                                AutomationProperties.Name="Full bust circumference in centimeters"
                                Maximum="145"
                                Minimum="65"
                                SmallChange="0.5"
                                StepFrequency="0.5"
                                Value="112"
                                ValueChanged="OnMeasurementChanged" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Natural waist" />
                                <TextBlock x:Name="WaistValueText" Style="{StaticResource MeasurementValueStyle}" Text="82 cm" />
                            </Grid>
                            <Slider
                                x:Name="WaistSlider"
                                AutomationProperties.Name="Natural waist circumference in centimeters"
                                Maximum="135"
                                Minimum="50"
                                SmallChange="0.5"
                                StepFrequency="0.5"
                                Value="82"
                                ValueChanged="OnMeasurementChanged" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Full hip" />
                                <TextBlock x:Name="HipValueText" Style="{StaticResource MeasurementValueStyle}" Text="108 cm" />
                            </Grid>
                            <Slider
                                x:Name="HipSlider"
                                AutomationProperties.Name="Full hip circumference in centimeters"
                                Maximum="155"
                                Minimum="70"
                                SmallChange="0.5"
                                StepFrequency="0.5"
                                Value="108"
                                ValueChanged="OnMeasurementChanged" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Shoulder breadth" />
                                <TextBlock x:Name="ShoulderValueText" Style="{StaticResource MeasurementValueStyle}" Text="37 cm" />
                            </Grid>
                            <Slider
                                x:Name="ShoulderSlider"
                                AutomationProperties.Name="Shoulder breadth in centimeters"
                                Maximum="55"
                                Minimum="30"
                                SmallChange="0.5"
                                StepFrequency="0.5"
                                Value="37"
                                ValueChanged="OnMeasurementChanged" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Torso length" />
                                <TextBlock x:Name="TorsoValueText" Style="{StaticResource MeasurementValueStyle}" Text="44 cm" />
                            </Grid>
                            <Slider
                                x:Name="TorsoSlider"
                                AutomationProperties.Name="Torso length in centimeters"
                                Maximum="58"
                                Minimum="32"
                                SmallChange="0.5"
                                StepFrequency="0.5"
                                Value="44"
                                ValueChanged="OnMeasurementChanged" />
                        </StackPanel>

                        <ComboBox
                            x:Name="PostureComboBox"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Posture profile"
                            Header="Posture profile"
                            SelectedIndex="1"
                            SelectionChanged="OnAvatarProfileChanged">
                            <ComboBoxItem Content="Forward shoulder" />
                            <ComboBoxItem Content="Balanced" />
                            <ComboBoxItem Content="Erect" />
                        </ComboBox>

                        <ItemsControl ItemsSource="{x:Bind MeasurementGroups, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander
                                        Margin="0,2,0,0"
                                        AutomationProperties.Name="{Binding Title}"
                                        Header="{Binding Title}"
                                        IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <StackPanel Padding="0,10,0,6" Spacing="8">
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Description}"
                                                TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{Binding Measurements}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <ItemsWrapGrid
                                                            MaximumRowsOrColumns="2"
                                                            Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <NumberBox
                                                            Width="184"
                                                            Margin="0,0,6,8"
                                                            AutomationProperties.Name="{Binding AutomationName}"
                                                            Header="{Binding DisplayLabel}"
                                                            Maximum="{Binding Maximum}"
                                                            Minimum="{Binding Minimum}"
                                                            SmallChange="{Binding Increment}"
                                                            SpinButtonPlacementMode="Compact"
                                                            Tag="{Binding Key}"
                                                            Value="{Binding Value, Mode=TwoWay}"
                                                            ValueChanged="OnDetailedMeasurementChanged" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Header="User-defined measurements">
                            <StackPanel Padding="0,10,0,6" Spacing="8">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Add uncommon tailoring dimensions or named landmarks. Photo estimates never lock manual entry."
                                    TextWrapping="Wrap" />
                                <ItemsControl ItemsSource="{x:Bind CustomMeasurements, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,8" ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="42" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    AutomationProperties.Name="Custom measurement name"
                                                    PlaceholderText="Measurement or landmark"
                                                    Text="{Binding Name, Mode=TwoWay}" />
                                                <NumberBox
                                                    Grid.Column="1"
                                                    AutomationProperties.Name="Custom measurement value"
                                                    Maximum="999"
                                                    Minimum="-999"
                                                    SmallChange="0.1"
                                                    SpinButtonPlacementMode="Compact"
                                                    Value="{Binding Value, Mode=TwoWay}"
                                                    ValueChanged="OnCustomMeasurementChanged" />
                                                <Button
                                                    Grid.Column="2"
                                                    AutomationProperties.Name="Remove custom measurement"
                                                    Click="OnRemoveCustomMeasurementClicked"
                                                    Content="×"
                                                    Tag="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button
                                    HorizontalAlignment="Left"
                                    AutomationProperties.Name="Add custom measurement"
                                    Click="OnAddCustomMeasurementClicked"
                                    Content="Add measurement" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="12">
                        <TextBlock FontWeight="SemiBold" Text="Fabric physics" />
                        <ComboBox
                            x:Name="FabricPresetComboBox"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Fabric preset"
                            Header="Material"
                            SelectedIndex="1"
                            SelectionChanged="OnFabricPresetChanged">
                            <ComboBoxItem Content="Silk charmeuse" Tag="silk" />
                            <ComboBoxItem Content="Lightweight cotton jersey" Tag="cotton" />
                            <ComboBoxItem Content="Linen twill" Tag="linen" />
                            <ComboBoxItem Content="Wool crepe" Tag="wool" />
                        </ComboBox>

                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Weight" />
                                <TextBlock x:Name="FabricWeightValueText" Style="{StaticResource MeasurementValueStyle}" Text="180 g/m²" />
                            </Grid>
                            <Slider
                                x:Name="FabricWeightSlider"
                                AutomationProperties.Name="Fabric weight in grams per square meter"
                                Maximum="420"
                                Minimum="35"
                                StepFrequency="5"
                                Value="180"
                                ValueChanged="OnFabricPhysicsChanged" />
                        </StackPanel>

                        <StackPanel Spacing="3">
                            <Grid>
                                <TextBlock Text="Bias stretch" />
                                <TextBlock x:Name="FabricStretchValueText" Style="{StaticResource MeasurementValueStyle}" Text="35%" />
                            </Grid>
                            <Slider
                                x:Name="FabricStretchSlider"
                                AutomationProperties.Name="Fabric bias stretch percentage"
                                Maximum="40"
                                Minimum="0"
                                StepFrequency="1"
                                Value="35"
                                ValueChanged="OnFabricPhysicsChanged" />
                        </StackPanel>

                        <Expander Header="Advanced material physics">
                            <StackPanel Padding="0,10,0,4" Spacing="10">
                                <NumberBox
                                    x:Name="BendNumberBox"
                                    AutomationProperties.Name="Fabric bending resistance"
                                    Header="Bending resistance"
                                    Maximum="100"
                                    Minimum="1"
                                    SmallChange="1"
                                    Value="8"
                                    ValueChanged="OnAdvancedPhysicsChanged" />
                                <NumberBox
                                    x:Name="FrictionNumberBox"
                                    AutomationProperties.Name="Surface friction"
                                    Header="Surface friction"
                                    Maximum="1"
                                    Minimum="0"
                                    SmallChange="0.05"
                                    Value="0.4"
                                    ValueChanged="OnAdvancedPhysicsChanged" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>

                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                    <StackPanel Spacing="10">
                        <Grid>
                            <TextBlock FontWeight="SemiBold" Text="Simulation evidence" />
                            <TextBlock
                                x:Name="FitEvidenceStatusText"
                                HorizontalAlignment="Right"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Not simulated" />
                        </Grid>

                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock
                                    x:Name="PeakStrainLabelText"
                                    Text="Peak material strain" />
                                <TextBlock
                                    x:Name="PeakStrainText"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No evidence" />
                            </Grid>
                            <ProgressBar
                                x:Name="PeakStrainProgress"
                                AutomationProperties.Name="Peak material strain relative to acceptance limit"
                                Maximum="100"
                                Value="84" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock Text="95th percentile strain" />
                                <TextBlock
                                    x:Name="P95StrainText"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No evidence" />
                            </Grid>
                            <ProgressBar
                                x:Name="P95StrainProgress"
                                AutomationProperties.Name="95th percentile material strain relative to acceptance limit"
                                Maximum="100"
                                Value="92" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock Text="Localized strain (99.9th)" />
                                <TextBlock
                                    x:Name="P999StrainText"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No evidence" />
                            </Grid>
                            <ProgressBar
                                x:Name="P999StrainProgress"
                                AutomationProperties.Name="99.9th percentile material strain relative to acceptance limit"
                                Maximum="100"
                                Value="0" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <Grid>
                                <TextBlock Text="Final intersections" />
                                <TextBlock
                                    x:Name="CollisionEvidenceText"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="No evidence" />
                            </Grid>
                            <ProgressBar
                                x:Name="CollisionEvidenceProgress"
                                AutomationProperties.Name="Final body and self intersection count"
                                Maximum="100"
                                Value="88" />
                        </StackPanel>

                        <Button
                            x:Name="RunSimulationButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Recalculate garment drape"
                            Click="OnRunSimulationClicked"
                            Content="Recalculate drape" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="EditorWidthStates">
                    <VisualState x:Name="WideEditor">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="1320" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PiecesPanel.Visibility" Value="Visible" />
                            <Setter Target="PiecesColumn.Width" Value="244" />
                            <Setter Target="InspectorPanel.Visibility" Value="Visible" />
                            <Setter Target="InspectorColumn.Width" Value="420" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="MediumEditor">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="900" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PiecesPanel.Visibility" Value="Collapsed" />
                            <Setter Target="PiecesColumn.Width" Value="0" />
                            <Setter Target="InspectorPanel.Visibility" Value="Visible" />
                            <Setter Target="InspectorColumn.Width" Value="380" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CompactEditor">
                        <VisualState.StateTriggers>
                            <AdaptiveTrigger MinWindowWidth="0" />
                        </VisualState.StateTriggers>
                        <VisualState.Setters>
                            <Setter Target="PiecesPanel.Visibility" Value="Collapsed" />
                            <Setter Target="PiecesColumn.Width" Value="0" />
                            <Setter Target="InspectorPanel.Visibility" Value="Collapsed" />
                            <Setter Target="InspectorColumn.Width" Value="0" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>

        <InfoBar
            x:Name="WorkspaceInfoBar"
            Grid.Row="2"
            IsClosable="True"
            IsOpen="False"
            Severity="Success" />
    </Grid>
</Page>
