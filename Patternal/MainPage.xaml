<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Patterna.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Patterna"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
    Loaded="OnPageLoaded"
    mc:Ignorable="d">

    <Grid x:Name="PageRoot" SizeChanged="OnPageRootSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar
            x:Name="EditorCommandBar"
            Grid.Row="0"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsDynamicOverflowEnabled="True">
            <CommandBar.Content>
                <StackPanel
                    Margin="12,0,24,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock
                        x:Name="GarmentTitleText"
                        VerticalAlignment="Center"
                        FontFamily="Segoe UI Variable Display"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Text="Adaptive crew-neck shirt" />
                    <Border
                        Padding="7,2"
                        Background="{ThemeResource AccentSoftBrush}"
                        CornerRadius="4">
                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource AccentStrongBrush}"
                            Text="DRAFT 08" />
                    </Border>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton
                x:Name="NewPatternButton"
                AutomationProperties.AutomationId="NewPatternButton"
                AutomationProperties.Name="Create a new pattern"
                Click="OnNewPatternClicked"
                Icon="Add"
                Label="New" />
            <AppBarButton
                x:Name="SavePatternSnapshotButton"
                AutomationProperties.AutomationId="SavePatternSnapshotButton"
                AutomationProperties.Name="Save pattern snapshot"
                Click="OnSavePatternClicked"
                Icon="Save"
                Label="Save" />
            <AppBarSeparator />
            <AppBarToggleButton
                x:Name="EditPatternPointsButton"
                AutomationProperties.HelpText="Show draggable pattern anchors and curve controls"
                AutomationProperties.Name="Edit pattern points"
                Click="OnEditPatternPointsClicked"
                Icon="Edit"
                Label="Edit points" />
            <AppBarToggleButton
                x:Name="EditAssemblyButton"
                AutomationProperties.HelpText="Inspect permanent seams and temporary garment closures on the authoritative pattern"
                AutomationProperties.Name="Inspect garment seam graph"
                Click="OnEditAssemblyClicked"
                Label="Assembly">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8EC;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton
                x:Name="UndoPatternEditButton"
                AutomationProperties.Name="Undo pattern geometry edit"
                Click="OnUndoPatternEditClicked"
                Icon="Undo"
                IsEnabled="False"
                Label="Undo" />
            <AppBarButton
                x:Name="RedoPatternEditButton"
                AutomationProperties.Name="Redo pattern geometry edit"
                Click="OnRedoPatternEditClicked"
                Icon="Redo"
                IsEnabled="False"
                Label="Redo" />
            <AppBarButton
                AutomationProperties.HelpText="Select front, side, and back reference photos"
                AutomationProperties.Name="Import body reference photos"
                Click="OnImportPhotosClicked"
                Label="Import photos">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE91B;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarToggleButton
                x:Name="PiecesToggleButton"
                AutomationProperties.Name="Show pattern pieces panel"
                Click="OnTogglePiecesClicked"
                IsChecked="True"
                Label="Pieces">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE8A5;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarToggleButton
                x:Name="InspectorToggleButton"
                AutomationProperties.Name="Show avatar and material inspector"
                Click="OnToggleInspectorClicked"
                IsChecked="True"
                Label="Inspector">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE713;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton
                x:Name="SimulateCommandButton"
                AutomationProperties.HelpText="Recalculate the current garment drape"
                AutomationProperties.Name="Run drape simulation"
                Click="OnRunSimulationClicked"
                Icon="Play"
                Label="Simulate" />
        </CommandBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="PiecesColumn" Width="244" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="InspectorColumn" Width="420" />
            </Grid.ColumnDefinitions>

            <Grid
                x:Name="PiecesPanel"
                Grid.Column="0"
                Padding="16,12,12,16"
                Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="3">
                    <TextBlock Style="{StaticResource EyebrowStyle}" Text="PATTERN PIECES" />
                        <TextBlock x:Name="PatternPieceCountText" Style="{StaticResource PanelHeadingStyle}" Text="8 pieces" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Text="Authoritative 2D source · fit view"
                            TextWrapping="Wrap" />
                        <ComboBox
                            x:Name="GarmentTemplateComboBox"
                            Margin="0,8,0,0"
                            AutomationProperties.Name="Garment document"
                            Header="Garment document"
                            SelectedIndex="0"
                            SelectionChanged="OnGarmentTemplateChanged">
                            <ComboBoxItem Content="Adaptive crew-neck shirt" Tag="adaptive-shirt" />
                            <ComboBoxItem Content="Wrap dress prototype" Tag="wrap-dress" />
                        </ComboBox>
                    </StackPanel>

                <ListView
                    x:Name="PatternPiecesList"
                    Grid.Row="1"
                    Margin="0,16,0,12"
                    AutomationProperties.Name="Pattern pieces"
                    ItemsSource="{x:Bind PatternPieceItems}"
                    SelectionChanged="OnPatternPieceSelectionChanged"
                    SelectionMode="Single"
                    SelectedIndex="0">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="34"
                                Height="42"
                                Background="{Binding Swatch}"
                                CornerRadius="9,4,9,4" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Detail}" />
                            </StackPanel>
                        </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <StackPanel Grid.Row="2" Spacing="10">
                    <Button
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Create a new editable pattern piece"
                        Click="OnAddPatternPieceClicked"
                        Content="Draft new piece" />
                    <Button
                        x:Name="DrawPolygonPieceButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Draw a polygon pattern piece directly on the canvas"
                        Click="OnStartCanvasPolygonDraftClicked"
                        Content="Draw polygon on canvas" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="AddInternalPathButton"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Add a precise internal line to the selected pattern piece"
                            Click="OnAddInternalPathClicked"
                            Content="Internal lines" />
                        <Button
                            x:Name="AddDartButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Add a precise dart to the selected pattern piece"
                            Click="OnAddDartClicked"
                            Content="Darts" />
                    </Grid>
                    <Button
                        x:Name="EditPatternPiecePropertiesButton"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="Edit construction properties for the selected pattern piece"
                        Click="OnEditPatternPiecePropertiesClicked"
                        Content="Piece settings" />
                    <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    <ToggleSwitch
                        x:Name="SeamAllowanceToggle"
                        AutomationProperties.Name="Show seam allowance"
                        Header="Seam allowance"
                        IsOn="True"
                        Toggled="OnPatternDisplayOptionChanged" />
                    <ToggleSwitch
                        x:Name="GrainlinesToggle"
                        AutomationProperties.Name="Show grainlines"
                        Header="Grainlines and notches"
                        IsOn="True"
                        Toggled="OnPatternDisplayOptionChanged" />
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button
                            HorizontalAlignment="Stretch"
                            AutomationProperties.Name="Zoom pattern to fit"
                            Click="OnFitPatternClicked"
                            Content="Fit view" />
                        <Button
                            x:Name="ExportPatternButton"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            AutomationProperties.AutomationId="ExportPatternButton"
                            AutomationProperties.Name="Export pattern"
                            Click="OnExportClicked"
                            Content="Export" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Grid.Column="1" Padding="10,0,10,10">
                <TabView
                    x:Name="WorkspaceTabs"
                    AutomationProperties.Name="Pattern workspace views"
                    HorizontalContentAlignment="Stretch"
                    IsAddTabButtonVisible="False"
                    SelectionChanged="OnWorkspaceTabsSelectionChanged"
                    SizeChanged="OnWorkspaceTabsSizeChanged"
                    TabWidthMode="Equal"
                    VerticalContentAlignment="Stretch">
                    <TabViewItem
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Header="2D FLAT"
                        IsClosable="False">
                        <Grid Background="{ThemeResource PatternCanvasBackgroundBrush}">
                            <ScrollViewer
                                x:Name="PatternScrollViewer"
                                Margin="12"
                                HorizontalScrollBarVisibility="Auto"
                                HorizontalScrollMode="Enabled"
                                MaxZoomFactor="16"
                                MinZoomFactor="0.5"
                                SizeChanged="OnPatternScrollViewerSizeChanged"
                                VerticalScrollBarVisibility="Auto"
                                VerticalScrollMode="Enabled"
                                ViewChanged="OnPatternScrollViewerViewChanged"
                                ZoomMode="Enabled">
                                <Canvas
                                    x:Name="PatternCanvas"
                                    Width="960"
                                    Height="720"
                                    Background="Transparent"
                                    AutomationProperties.Name="Interactive two dimensional pattern layout"
                                    PointerMoved="OnPatternCanvasPointerMoved"
                                    PointerPressed="OnPatternCanvasPointerPressed" />
                            </ScrollViewer>

                            <StackPanel
                                Margin="20"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                Spacing="4">
                                <Border
                                    Padding="8,4"
                                    HorizontalAlignment="Left"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    CornerRadius="4">
                                    <TextBlock
                                        x:Name="SmartLayoutText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="AUTO LAYOUT · ALL PIECES VISIBLE" />
                                </Border>
                            </StackPanel>

                            <Border
                                x:Name="PatternPointInspector"
                                Width="240"
                                Margin="16"
                                Padding="12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="{ThemeResource PatternOverlayBackgroundBrush}"
                                BorderBrush="{ThemeResource PatternOverlayBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="PATTERN POINT" />
                                    <TextBlock
                                        x:Name="SelectedPatternPointText"
                                        FontWeight="SemiBold"
                                        Text="Select an anchor or curve control" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            x:Name="SelectedPatternPointXNumberBox"
                                            AutomationProperties.Name="Selected pattern point X coordinate in centimeters"
                                            Header="X (cm)"
                                            IsEnabled="False"
                                            Maximum="300"
                                            Minimum="-100"
                                            SmallChange="0.1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnSelectedPatternPointValueChanged" />
                                        <NumberBox
                                            x:Name="SelectedPatternPointYNumberBox"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Selected pattern point Y coordinate in centimeters"
                                            Header="Y (cm)"
                                            IsEnabled="False"
                                            Maximum="300"
                                            Minimum="-100"
                                            SmallChange="0.1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnSelectedPatternPointValueChanged" />
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            x:Name="SelectedPatternSegmentLengthNumberBox"
                                            AutomationProperties.Name="Selected pattern segment length in centimeters"
                                            Header="Length (cm)"
                                            IsEnabled="False"
                                            Maximum="500"
                                            Minimum="0.1"
                                            SmallChange="0.1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnSelectedPatternSegmentValueChanged" />
                                        <NumberBox
                                            x:Name="SelectedPatternSegmentAngleNumberBox"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Selected pattern segment angle in degrees"
                                            Header="Angle (deg)"
                                            IsEnabled="False"
                                            Maximum="360"
                                            Minimum="-360"
                                            SmallChange="0.1"
                                            SpinButtonPlacementMode="Compact"
                                            ValueChanged="OnSelectedPatternSegmentValueChanged" />
                                    </Grid>
                                    <Button
                                        x:Name="ResetPatternPointButton"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Reset selected point to generated position"
                                        Click="OnResetPatternPointClicked"
                                        Content="Reset to generated point"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="SplitPatternSegmentButton"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Split selected pattern segment at its midpoint"
                                        Click="OnSplitPatternSegmentClicked"
                                        Content="Split segment at midpoint"
                                        IsEnabled="False" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="ConvertPatternSegmentToCurveButton"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Convert selected straight segment to an editable cubic curve"
                                            Click="OnConvertPatternSegmentToCurveClicked"
                                            Content="Make curve"
                                            IsEnabled="False" />
                                        <Button
                                            x:Name="ConvertPatternSegmentToLineButton"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Convert selected cubic segment to a straight line"
                                            Click="OnConvertPatternSegmentToLineClicked"
                                            Content="Make line"
                                            IsEnabled="False" />
                                    </Grid>
                                    <Button
                                        x:Name="AddPatternNotchButton"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Add a construction notch to the selected pattern segment"
                                        Click="OnAddPatternNotchClicked"
                                        Content="Add notch at midpoint"
                                        IsEnabled="False" />
                                    <TextBlock
                                        x:Name="PendingSewingEdgeText"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Free sewing: select an edge, mark it, then select its partner."
                                        TextWrapping="Wrap" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="MarkSewingEdgeButton"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Mark selected edge as the first free sewing side"
                                            Click="OnMarkSewingEdgeClicked"
                                            Content="Mark edge"
                                            IsEnabled="False" />
                                        <Button
                                            x:Name="CompleteSewingEdgeButton"
                                            Grid.Column="1"
                                            HorizontalAlignment="Stretch"
                                            AutomationProperties.Name="Sew the marked edge to the selected edge"
                                            Click="OnCompleteSewingEdgeClicked"
                                            Content="Sew edges"
                                            IsEnabled="False" />
                                    </Grid>
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Drag to edit. Shift bypasses the 0.1 cm snap. Coordinate and structural edits survive measurement changes."
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="CanvasDraftToolbar"
                                Canvas.ZIndex="150"
                                Margin="20"
                                Padding="12"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource PatternOverlayBackgroundBrush}"
                                BorderBrush="{ThemeResource PatternOverlayBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        x:Name="CanvasDraftStatusText"
                                        FontWeight="SemiBold"
                                        Text="Click to place polygon points"
                                        TextAlignment="Center" />
                                    <StackPanel HorizontalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="X (cm)" />
                                        <NumberBox
                                            x:Name="CanvasDraftXNumberBox"
                                            Width="92"
                                            AutomationProperties.Name="Canvas polygon point X coordinate in centimeters"
                                            LargeChange="1"
                                            Maximum="1000"
                                            Minimum="0"
                                            SmallChange="0.1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="10" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Text="Y (cm)" />
                                        <NumberBox
                                            x:Name="CanvasDraftYNumberBox"
                                            Width="92"
                                            AutomationProperties.Name="Canvas polygon point Y coordinate in centimeters"
                                            LargeChange="1"
                                            Maximum="1000"
                                            Minimum="0"
                                            SmallChange="0.1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="10" />
                                        <Button
                                            AutomationProperties.Name="Add the entered point to the canvas polygon"
                                            Click="OnAddCanvasDraftPointClicked"
                                            Content="Add point" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Button
                                            x:Name="UndoCanvasDraftPointButton"
                                            AutomationProperties.Name="Remove the most recent polygon point"
                                            Click="OnUndoCanvasDraftPointClicked"
                                            Content="Undo point"
                                            IsEnabled="False" />
                                        <Button
                                            x:Name="FinishCanvasDraftButton"
                                            AutomationProperties.Name="Finish the polygon pattern piece"
                                            Click="OnFinishCanvasDraftClicked"
                                            Content="Finish piece"
                                            IsEnabled="False" />
                                        <Button
                                            AutomationProperties.Name="Cancel canvas pattern drafting"
                                            Click="OnCancelCanvasDraftClicked"
                                            Content="Cancel" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="AssemblyInspector"
                                Canvas.ZIndex="100"
                                Width="280"
                                Margin="20"
                                Padding="12"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                Background="#FF1D2028"
                                BorderBrush="{ThemeResource PatternOverlayBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <StackPanel Spacing="8">
                                    <TextBlock
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="SEAM GRAPH" />
                                    <TextBlock
                                        x:Name="AssemblySummaryText"
                                        FontWeight="SemiBold"
                                        Text="11 permanent seams · 3 closures" />
                                    <ComboBox
                                        x:Name="AssemblyRelationshipComboBox"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Selected seam or garment closure"
                                        Header="Relationship"
                                        SelectionChanged="OnAssemblyRelationshipSelectionChanged" />
                                    <TextBlock
                                        x:Name="AssemblyRelationshipTypeText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Select a colored edge or relationship"
                                        TextWrapping="Wrap" />
                                    <Border
                                        x:Name="AssemblySeamFitCard"
                                        Padding="10,8"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                        <StackPanel Spacing="3">
                                            <TextBlock
                                                FontSize="10"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="SEWN LENGTH COMPATIBILITY" />
                                            <TextBlock
                                                x:Name="AssemblySeamLengthText"
                                                FontWeight="SemiBold"
                                                Text="Side A 0.00 cm · Side B 0.00 cm" />
                                            <TextBlock
                                                x:Name="AssemblySeamMismatchText"
                                                FontSize="11"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Select a permanent seam"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <ToggleSwitch
                                        x:Name="ReverseSeamSideBToggle"
                                        AutomationProperties.Name="Reverse selected seam side B sewing direction"
                                        Header="Reverse side B direction"
                                        IsEnabled="False"
                                        Toggled="OnReverseSeamSideBToggled" />
                                    <ToggleSwitch
                                        x:Name="ClosureStateToggle"
                                        AutomationProperties.Name="Close selected temporary garment closure"
                                        Header="Closure engaged"
                                        IsEnabled="False"
                                        Toggled="OnClosureStateToggled" />
                                    <TextBlock
                                        x:Name="AssemblyRelationshipLocationText"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Permanent seams are cyan. Closures are gold."
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="ResetAssemblyEditButton"
                                        HorizontalAlignment="Stretch"
                                        AutomationProperties.Name="Reset selected assembly relationship"
                                        Click="OnResetAssemblyEditClicked"
                                        Content="Reset relationship"
                                        IsEnabled="False" />
                                </StackPanel>
                            </Border>

                            <Border
                                MaxWidth="360"
                                Margin="20"
                                Padding="10,6"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE82D;" />
                                    <TextBlock
                                        x:Name="CanvasScaleText"
                                        AutomationProperties.AutomationId="CanvasScaleText"
                                        Text="10 cm grid | 50 cm major | screen uncalibrated" />
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="20"
                                Padding="6"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                CornerRadius="4">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button
                                        x:Name="PatternZoomOutButton"
                                        Width="34"
                                        AutomationProperties.AutomationId="PatternZoomOutButton"
                                        AutomationProperties.Name="Zoom pattern out"
                                        Click="OnPatternZoomOutClicked"
                                        Content="-" />
                                    <TextBlock
                                        x:Name="PatternZoomText"
                                        Width="52"
                                        AutomationProperties.AutomationId="PatternZoomText"
                                        HorizontalTextAlignment="Center"
                                        Text="100%"
                                        VerticalAlignment="Center" />
                                    <Button
                                        x:Name="PatternZoomInButton"
                                        Width="34"
                                        AutomationProperties.AutomationId="PatternZoomInButton"
                                        AutomationProperties.Name="Zoom pattern in"
                                        Click="OnPatternZoomInClicked"
                                        Content="+" />
                                    <Button
                                        x:Name="PatternFitButton"
                                        AutomationProperties.AutomationId="PatternFitButton"
                                        AutomationProperties.Name="Fit all pattern pieces"
                                        Click="OnFitPatternClicked"
                                        Content="Fit" />
                                    <Button
                                        x:Name="PatternFrameSelectedButton"
                                        AutomationProperties.AutomationId="PatternFrameSelectedButton"
                                        AutomationProperties.Name="Frame selected pattern piece"
                                        Click="OnFrameSelectedPatternClicked"
                                        Content="Frame" />
                                    <Button
                                        x:Name="PatternActualSizeButton"
                                        AutomationProperties.AutomationId="PatternActualSizeButton"
                                        AutomationProperties.Name="Show pattern at calibrated actual size"
                                        Click="OnPatternActualSizeClicked"
                                        Content="1:1"
                                        IsEnabled="False" />
                                    <Button
                                        x:Name="PatternCalibrateScaleButton"
                                        AutomationProperties.AutomationId="PatternCalibrateScaleButton"
                                        AutomationProperties.Name="Calibrate pattern physical scale"
                                        Click="OnCalibratePatternScaleClicked"
                                        Content="Calibrate" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabViewItem>

                    <TabViewItem
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Header="3D DRAPE"
                        IsClosable="False">
                        <Grid x:Name="DrapeSurfaceGrid" Background="#0B0C10">
                            <Image
                                x:Name="HighFidelityPreviewImage"
                                AutomationProperties.Name="High fidelity Patternal cloth preview"
                                Source="ms-appx:///Assets/Production/patterna-production-front.png"
                                Stretch="Uniform" />

                            <WebView2
                                x:Name="DrapeWebView"
                                AutomationProperties.HelpText="Drag to orbit and use the mouse wheel to zoom"
                                AutomationProperties.Name="Internal browser cloth diagnostic"
                                DefaultBackgroundColor="#090B10"
                                Visibility="Collapsed" />

                            <Border
                                x:Name="UnacceptedGarmentNotice"
                                Width="520"
                                Padding="28"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="#F2191A21"
