                                        AutomationProperties.Name="Underarm junction extension in centimeters"
                                        Header="Underarm extension (cm)"
                                        Maximum="3"
                                        Minimum="0"
                                        SmallChange="0.05"
                                        Value="0"
                                        ValueChanged="OnShirtConstructionChanged" />
