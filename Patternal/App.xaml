<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Patterna.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Patterna">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="PatternCanvasBackgroundBrush" Color="#15161C" />
                    <SolidColorBrush x:Key="PatternGridBrush" Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="PatternPieceFillBrush" Color="#DCD7FF" />
                    <SolidColorBrush x:Key="PatternPieceSecondaryFillBrush" Color="#B9E7D4" />
                    <SolidColorBrush x:Key="PatternPieceStrokeBrush" Color="#FFFDFB" />
                    <SolidColorBrush x:Key="PatternDimensionBrush" Color="#BBB8C7" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#332F81F7" />
                    <SolidColorBrush x:Key="AccentStrongBrush" Color="#8C7CFF" />
                    <SolidColorBrush x:Key="PatternOverlayBackgroundBrush" Color="#F21D2028" />
                    <SolidColorBrush x:Key="PatternOverlayBorderBrush" Color="#38FFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PatternCanvasBackgroundBrush" Color="#F3F1EC" />
                    <SolidColorBrush x:Key="PatternGridBrush" Color="#1C27242E" />
                    <SolidColorBrush x:Key="PatternPieceFillBrush" Color="#E5E0FF" />
                    <SolidColorBrush x:Key="PatternPieceSecondaryFillBrush" Color="#CDEEDD" />
                    <SolidColorBrush x:Key="PatternPieceStrokeBrush" Color="#332E43" />
                    <SolidColorBrush x:Key="PatternDimensionBrush" Color="#625E69" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1F5B4BCE" />
                    <SolidColorBrush x:Key="AccentStrongBrush" Color="#5B4BCE" />
                    <SolidColorBrush x:Key="PatternOverlayBackgroundBrush" Color="#FAFFFFFF" />
                    <SolidColorBrush x:Key="PatternOverlayBorderBrush" Color="#2A27242E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="PatternCanvasBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PatternGridBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="PatternPieceFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PatternPieceSecondaryFillBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PatternPieceStrokeBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
                    <SolidColorBrush x:Key="PatternDimensionBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="AccentStrongBrush" Color="{ThemeResource SystemColorHighlightColor}" />
                    <SolidColorBrush x:Key="PatternOverlayBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="PatternOverlayBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <Style x:Key="PanelHeadingStyle" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Variable Display" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="EyebrowStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="CharacterSpacing" Value="90" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <Style x:Key="MeasurementValueStyle" TargetType="TextBlock">
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
